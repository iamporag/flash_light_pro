# Copy this file to android/key.properties and fill in your upload keystore details.
# The real key.properties and keystore files must never be committed.
#
# Generate an upload keystore (run from the android/ directory):
#   keytool -genkeypair -v -keystore keystore/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to android/app/.
storePassword=REPLACE_WITH_STORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=upload
storeFile=../keystore/upload-keystore.jks
